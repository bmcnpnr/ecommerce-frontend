# ── Local development (npm run dev) ─────────────────────────────────────────
# Vite proxies /api to this address in dev mode (see vite.config.ts).
# Set to the API Gateway URL running on your machine.
VITE_API_BASE_URL=http://localhost:8080

# ── Docker / production ──────────────────────────────────────────────────────
# When running inside the Docker Compose stack, leave this as '/' (the default).
# nginx will proxy /api requests to api-gateway:8080 within the Docker network.
# VITE_API_BASE_URL=/
#
# To deploy behind a public domain, override at build time:
#   docker compose build --build-arg VITE_API_BASE_URL=https://api.example.com
